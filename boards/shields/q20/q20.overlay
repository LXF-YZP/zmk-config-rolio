#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/*
 * Seeeduino XIAO BLE (nRF52840) 的 Q20 shield。
 *
 * 按原理图对应的主控引脚：
 *   KEYA / KEYB -> P0.02 / P0.03（触控板按压开关的两端，FPC 15/14 脚）
 *   row7        -> P0.29
 *   col7        -> P0.28
 *   col8        -> P1.15
 *   col9        -> P1.14
 *   TP_SDA/SCL  -> P0.04 / P0.05（i2c0）
 *   TPBLK       -> P1.13（Q2 栅极，R4 下拉；高电平点亮触控板背光）
 *   KEY3        -> NRST（硬件复位，不作为键盘按键）
 *
 * 三枚 Kailh 按键按图中从左到右的 col7、col8、col9 顺序映射。
 * 二极管阴极接列，电流由行流向列，使用 row2col 扫描。
 */

/ {
    chosen {
        zmk,kscan = &kscan_composite;
        zmk,backlight = &backlight;
    };

    /* 触控板背光：P1.13 经 Q2（AO3400A）低边驱动 TPBLK_LEDK，用 PWM 调光。 */
    backlight: pwmleds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
        };
    };

    /* 三枚 Kailh 按键：一行三列矩阵。 */
    kscan_matrix: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        row-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
        col-gpios = <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        diode-direction = "row2col";
    };

    /*
     * 触控板按压开关：KEYA、KEYB 是同一个开关的两端，两端都不接地，
     * 所以不能用上拉 + 低电平有效的 direct 扫描，按 1×1 矩阵处理：
     * KEYA 输出高电平，KEYB 下拉输入，按下时 KEYB 读到高电平。
     */
    kscan_click: kscan_click {
        compatible = "zmk,kscan-gpio-matrix";
        row-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
        col-gpios = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        diode-direction = "row2col";
    };

    /* 三枚矩阵按键在前（第 0~2 位），触控板按压排在第 3 位。 */
    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <1>;
        columns = <4>;

        matrix {
            kscan = <&kscan_matrix>;
        };

        click {
            kscan = <&kscan_click>;
            column-offset = <3>;
        };
    };
};

/* XIAO 默认 i2c0 的 P0.04/P0.05 经电平转换后连接 A320 触控板。 */
&i2c0 {
    status = "okay";

    a320: a320@3b {
        compatible = "avago,a320";
        status = "okay";
        reg = <0x3B>;
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;
            low-power-enable;
        };
    };
};
