#include <zephyr/dt-bindings/gpio/gpio.h>

/*
 * Seeeduino XIAO BLE (nRF52840) 的 Q20 shield。
 *
 * 按原理图对应的主控引脚：
 *   KEYA / KEYB -> P0.02 / P0.03（触控板左右键，独立输入）
 *   row7        -> P0.29
 *   col7        -> P0.28
 *   col8        -> P1.15
 *   col9        -> P1.14
 *   TP_SDA/SCL  -> P0.04 / P0.05（i2c0）
 *   KEY3        -> NRST（硬件复位，不作为键盘按键）
 *
 * 三枚 Kailh 按键按图中从左到右的 col7、col8、col9 顺序映射。
 * 二极管阴极接列，电流由行流向列，使用 row2col 扫描。
 */

/ {
    chosen {
        zmk,kscan = &kscan_composite;
    };

    /* 三枚 Kailh 按键：一行三列矩阵。 */
    kscan_matrix: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        row-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
        col-gpios = <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        diode-direction = "row2col";
    };

    /* 触控板 KEYA/KEYB 左右键，低电平有效。 */
    kscan_clicks: kscan_clicks {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /* 三枚矩阵按键在前，左右点击键排在其后。 */
    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <1>;
        columns = <5>;

        matrix {
            kscan = <&kscan_matrix>;
        };

        clicks {
            kscan = <&kscan_clicks>;
            column-offset = <3>;
        };
    };
};

/* XIAO 默认 i2c0 的 P0.04/P0.05 经电平转换后连接 A320 触控板。 */
&i2c0 {
    status = "okay";

    a320: a320@3b {
        compatible = "avago,a320";
        status = "okay";
        reg = <0x3B>;
    };
};
