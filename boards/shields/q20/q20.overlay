#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/*
 * nice!nano v2 的 Q20 shield。A320 触控板经 trackpad_breakout 转接板连接，
 * 接线见 trackpad_breakout 的 out/nice_nano_wiring.pdf：
 *   J2 GND  -> GND
 *   J2 3V3  -> VCC（P0.13 控制的 EXT_POWER，由 nice_nano_v2 板子定义管理）
 *   J2 SCL  -> P0.20 (D3)   i2c0 默认引脚
 *   J2 SDA  -> P0.17 (D2)   i2c0 默认引脚
 *   J3 KEYA -> P0.24 (D5)   触控板按压开关一端，扫描时输出高电平
 *   J3 KEYB -> P0.06 (D1)   触控板按压开关另一端，下拉输入，按下为高电平
 *   J3 BLK  -> P0.08 (D0)   触控板背光 PWM，高电平点亮
 *   J3 MOT  -> P0.22 (D4)   固件不使用：驱动按 CONFIG_INPUT_A320_POLLINGRATE 轮询
 *
 * 不接 Kailh 按键，唯一的按键是触控板按压。
 * 复位键接 nice!nano 的 RST 和 GND。
 */

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,backlight = &backlight;
    };

    /*
     * 触控板按压开关：KEYA、KEYB 是同一个开关的两端，都接 GPIO，按 1×1 矩阵处理
     * （与 q20 分支相同）：KEYA 输出高电平，KEYB 下拉输入，按下时 KEYB 读到高电平。
     */
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        row-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
        col-gpios = <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        diode-direction = "row2col";
    };

    /* 触控板背光：BLK 经 Q3 低边开关驱动背光 LED，板上 R16 下拉，PWM 停止时熄灭。 */
    backlight: pwmleds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
        };
    };
};

/*
 * nice_nano_v2 的 i2c0 默认就是 P0.17/P0.20，不需要改 pinctrl。
 * 上拉和 1.8V 电平转换都在转接板上，不开内部上拉。
 * 不要给 a320 节点加 motion-gpios 等属性：fork 的 a320.h 会把它们
 * 展开成不存在的 reset_gpios，导致编译失败。
 */
&i2c0 {
    status = "okay";

    a320: a320@3b {
        compatible = "avago,a320";
        status = "okay";
        reg = <0x3B>;
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 8)>;
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 8)>;
            low-power-enable;
        };
    };
};
