#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/*
 * nice!nano v2 的 Q20 shield。A320 触控板经 trackpad_breakout 转接板连接，
 * 接线见 trackpad_breakout 的 out/nice_nano_wiring.pdf：
 *   J2 GND  -> GND
 *   J2 3V3  -> VCC（P0.13 控制的 EXT_POWER，由 nice_nano_v2 板子定义管理）
 *   J2 SCL  -> P0.20 (D3)   i2c0 默认引脚
 *   J2 SDA  -> P0.17 (D2)   i2c0 默认引脚
 *   J3 KEYA -> GND
 *   J3 KEYB -> P0.06 (D1)   触控板按压，按下为低电平
 *   J3 BLK  -> P0.08 (D0)   触控板背光 PWM，高电平点亮
 *   J3 MOT  -> P0.22 (D4)   固件不使用：驱动按 CONFIG_INPUT_A320_POLLINGRATE 轮询
 *
 * 三枚 Kailh 按键（从左到右）一端接 GND，另一端接：
 *   P0.24 (D5)、P1.00 (D6)、P0.11 (D7)
 * 原来接 NRST 的复位键改接 nice!nano 的 RST 和 GND。
 */

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,backlight = &backlight;
    };

    /*
     * 所有按键一端都接地，用 direct 扫描：内部上拉，低电平有效。
     * 三枚 Kailh 键在前（第 0~2 位），触控板按压排在第 3 位。
     */
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios = <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&gpio1 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /* 触控板背光：BLK 经 Q3 低边开关驱动背光 LED，板上 R16 下拉，PWM 停止时熄灭。 */
    backlight: pwmleds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
        };
    };
};

/*
 * nice_nano_v2 的 i2c0 默认就是 P0.17/P0.20，不需要改 pinctrl。
 * 上拉和 1.8V 电平转换都在转接板上，不开内部上拉。
 * 不要给 a320 节点加 motion-gpios 等属性：fork 的 a320.h 会把它们
 * 展开成不存在的 reset_gpios，导致编译失败。
 */
&i2c0 {
    status = "okay";

    a320: a320@3b {
        compatible = "avago,a320";
        status = "okay";
        reg = <0x3B>;
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 8)>;
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 8)>;
            low-power-enable;
        };
    };
};
