/*
 * Prospector ST7789 display wiring for the Sofle left controller.
 *
 * P0.24 is used by the display reset line and P1.11 by its backlight;
 * sofle_left.overlay moves the affected matrix columns to P0.22 and P1.13.
 */

&pinctrl {
    prospector_spi3_default: prospector_spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
        };
    };

    prospector_spi3_sleep: prospector_spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
            low-power-enable;
        };
    };

    prospector_pwm1_default: prospector_pwm1_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 11)>;
            nordic,invert;
        };
    };

    prospector_pwm1_sleep: prospector_pwm1_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 11)>;
            low-power-enable;
        };
    };

};

prospector_disp_spi: &spi3 {
    status = "okay";
    pinctrl-0 = <&prospector_spi3_default>;
    pinctrl-1 = <&prospector_spi3_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
};

&pro_micro_i2c {
    status = "disabled";
};

&oled {
    status = "disabled";
};

/ {
    /* nice!nano v2 normally uses P0.13 for external-power control. */
    /delete-node/ EXT_POWER;

    pwmleds {
        compatible = "pwm-leds";

        disp_bl: pwm_led_1 {
            pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
        };
    };

    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&spi3>;
        dc-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
        write-only;
        #address-cells = <1>;
        #size-cells = <0>;

        st7789: st7789v@0 {
            compatible = "sitronix,st7789v";
            mipi-max-frequency = <30000000>;
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            reg = <0>;
            width = <240>;
            height = <280>;
            /*
             * Prospector first applies its built-in 270-degree orientation,
             * then src/prospector_portrait.c applies the final 180-degree
             * orientation. The ST7789 driver mutates these offsets on each
             * orientation change, so use the swapped initial values here to
             * make the final 180-degree window land at x=0, y=20.
             */
            x-offset = <20>;
            y-offset = <0>;
            vcom = <0x19>;
            gctrl = <0x35>;
            vrhs = <0x12>;
            vdvs = <0x20>;
            mdac = <0x00>;
            gamma = <0x01>;
            colmod = <0x05>;
            lcm = <0x2c>;
            porch-param = [ 0c 0c 00 33 33 ];
            cmd2en-param = [ 5a 69 02 01 ];
            pwctrl1-param = [ a4 a1 ];
            pvgam-param = [ d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23 ];
            nvgam-param = [ d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23 ];
            ram-param = [ 00 f0 ];
            rgb-param = [ cd 08 14 ];
        };
    };
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&prospector_pwm1_default>;
    pinctrl-1 = <&prospector_pwm1_sleep>;
    pinctrl-names = "default", "sleep";
};
