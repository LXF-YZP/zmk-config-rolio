/*
 * Q20 触控板键盘键位（nice!nano v2，触控板按压 1×1 矩阵）。
 *
 * 只有一个按键：触控板按压（KEYA 接 P0.24，KEYB 接 P0.06），默认作为鼠标左键。
 * 复位键接 nice!nano 的 RST，直接硬件复位 MCU，不在键位表里。
 * 没有 Kailh 键，也就没有背光开关组合键；背光上电默认开启。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mkp LCLK
            >;
        };
    };
};
