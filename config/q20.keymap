/*
 * Q20 触控板键盘键位。
 *
 * 三枚 Kailh 机械键组成一行三列矩阵，默认键位为 Esc、空格、回车，可按需修改。
 * KEYA/KEYB 分别作为触控板左键/右键；KEY3 连接 NRST，直接硬件复位 MCU。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC    &kp SPACE  &kp ENTER  &mkp LCLK  &mkp RCLK
            >;
        };
    };
};
