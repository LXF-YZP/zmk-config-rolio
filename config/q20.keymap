/*
 * Q20 触控板键盘键位。
 *
 * 三枚 Kailh 机械键组成一行三列矩阵，默认键位为右 Option（RALT）、空格、回车，可按需修改。
 * 第 4 位是触控板按压（KEYA/KEYB 是同一个开关的两端），默认作为鼠标左键。
 * 硬件上没有单独的右键，需要右键时可把前三个键之一改成 &mkp RCLK。
 * KEY3 连接 NRST，直接硬件复位 MCU，不在键位表里。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        /* RALT + ENTER：清除当前蓝牙 profile 的配对信息。 */
        bt_clear {
            timeout-ms = <400>;
            key-positions = <0 2>;
            bindings = <&bt BT_CLR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp RALT   &kp SPACE  &kp ENTER  &mkp LCLK
            >;
        };

        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
    };
};
